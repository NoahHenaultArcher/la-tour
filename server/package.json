{
  "name": "@la-tour/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "start:prod": "prisma migrate deploy && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=../.env prisma/seed.ts",
    "db:studio": "dotenv -e ../.env -- prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "@la-tour/shared": "workspace:*",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "fastify": "^5.0.0",
    "prisma": "^6.0.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv-cli": ">=8.0.0 <12",
    "socket.io-client": "^4.8.4",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
