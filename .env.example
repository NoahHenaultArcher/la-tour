# Copier ce fichier en .env (non versionné) et adapter les valeurs.

# --- Base de données (docker compose) ---
POSTGRES_USER=latour
POSTGRES_PASSWORD=latour
POSTGRES_DB=latour
POSTGRES_PORT=5432
DATABASE_URL=postgresql://latour:latour@localhost:5432/latour?schema=public

# --- Serveur ---
NODE_ENV=development
SERVER_PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# --- Hébergement (Render…) : inutile en local ---
# PORT est fourni par l'hébergeur et remplace SERVER_PORT.
# HOST=0.0.0.0
# TRUST_PROXY=true

# --- Compte admin créé par le seed (développement uniquement) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
