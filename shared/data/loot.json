  "rules": [
    {
      "topic": "Tirage",
      "rule": "À chaque victoire : tirage « chance de butin » du rang. Si réussi : nombre d'objets, puis pour chaque objet un tirage de rareté dans la table du biome."
    },
    {
      "topic": "Biome",
      "rule": "Le biome est celui de l'étage (ou de la zone de chasse) : zone de chasse 55 → table Océan, même si le monstre est niveau 65."
    },
    {
      "topic": "Objet",
      "rule": "Classe du joueur, slot au hasard (10 slots équiprobables). Matériau = palier de l'étage ou de la zone (zone 55 → mithril), amélioration +0. Le joueur l'améliore ensuite avec ce matériau (fichier Équipements)."
    },
    {
      "topic": "Unique",
      "rule": "Si la rareté tirée est Unique : l'Unique du biome pour la classe du joueur (section 5). S'il le possède déjà, il peut être revendu ou recyclé (à décider)."
    },
    {
      "topic": "Progression",
      "rule": "Raretés débloquées par biome : les monstres ont un biome de retard sur les boss, les dragons un peu d'avance. Les Uniques sont surtout une récompense de boss/dragon."
    }
  ]
}
